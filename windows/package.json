{
  "name": "musichub-desktop-windows",
  "version": "1.2.1",
  "description": "MusicHub Desktop client for Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "make-icon": "node scripts/make-icon.js",
    "dist": "npm run make-icon && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "png-to-ico": "2.1.8"
  },
  "build": {
    "appId": "ro.musichub.classic",
    "productName": "MusicHub Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["ia32", "x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MusicHub-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MusicHub Desktop"
    }
  }
}
